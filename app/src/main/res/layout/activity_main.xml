<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout
        android:id="@+id/welcomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1015">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:background="#11151C">
            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/vlc_osd_background"
                android:text="▶"
                android:textColor="#FF7A24"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="11dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MPM"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIDEO PLAYER"
                    android:textColor="#8993A1"
                    android:textSize="9sp"
                    android:letterSpacing="0.18" />
            </LinearLayout>
            <Button
                android:id="@+id/btnLibraryRefresh"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="42dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⟳"
                android:textColor="#DCE2EA"
                android:textSize="22sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Actualizar biblioteca" />
            <Button
                android:id="@+id/btnLibrarySettings"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="42dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⚙"
                android:textColor="#DCE2EA"
                android:textSize="19sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ajustes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="15dp">
            <TextView
                android:id="@+id/libraryHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu biblioteca"
                android:textColor="#F7F8FA"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/librarySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tus vídeos, siempre a mano"
                android:textColor="#929CAB"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="12dp"
            android:background="@drawable/library_search_background">
            <TextView
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#AAB4C2"
                android:textSize="24sp" />
            <EditText
                android:id="@+id/librarySearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar en tu biblioteca"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8998"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="5dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="7dp"
            android:scrollbars="none"
            android:fillViewport="false">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <Button
                    android:id="@+id/btnLibraryVideos"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="Vídeos"
                    android:textAllCaps="false"
                    android:textColor="#FF8738"
                    android:textSize="13sp"
                    android:background="@drawable/library_tab_active" />
                <Button
                    android:id="@+id/btnLibraryFolders"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="Carpetas"
                    android:textAllCaps="false"
                    android:textColor="#AAB3C0"
                    android:textSize="13sp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
                <Button
                    android:id="@+id/btnLibraryRecent"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="Recientes"
                    android:textAllCaps="false"
                    android:textColor="#AAB3C0"
                    android:textSize="13sp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
                <Button
                    android:id="@+id/btnLibraryFavorites"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="Favoritos"
                    android:textAllCaps="false"
                    android:textColor="#AAB3C0"
                    android:textSize="13sp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#222934" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/libraryItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="18dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#11151C">
            <Button
                android:id="@+id/btnLibraryOpen"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="＋   Abrir archivo"
                android:textAllCaps="false"
                android:textColor="#17191D"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/library_primary_button" />
            <Button
                android:id="@+id/btnLibraryPlaylist"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="94dp"
                android:layout_height="48dp"
                android:layout_marginStart="9dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="☷  Lista"
                android:textAllCaps="false"
                android:textColor="#E1E6ED"
                android:textSize="13sp"
                android:background="@drawable/library_secondary_button" />
        </LinearLayout>
    </LinearLayout>
<LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="48dp"
    android:layout_gravity="top" android:background="@drawable/vlc_hud_top" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp"
    android:paddingTop="2dp" android:paddingBottom="2dp">
    <ImageButton android:id="@+id/btnPlayerBack" style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="40dp" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="0dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFFFFFF" android:scaleType="center" android:contentDescription="Volver a la biblioteca" />
    <TextView android:id="@+id/txtStatus" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="center" android:maxLines="1" android:singleLine="true"
        android:ellipsize="middle" android:text="Listo" android:textColor="#FFFFFFFF" android:textSize="16sp"
        android:fontFamily="sans-serif-medium" android:shadowColor="#99000000" android:shadowRadius="5" android:shadowDy="1" />
    <View android:layout_width="40dp" android:layout_height="1dp" />
</LinearLayout>
<LinearLayout android:id="@+id/centerControls" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_gravity="center" android:gravity="center" android:orientation="horizontal"
    android:visibility="gone">
    <ImageButton android:id="@+id/btnCenterPlay" style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/vlc_ic_play_player"
        android:scaleType="fitCenter" android:padding="8dp" android:contentDescription="Reproducir" />
</LinearLayout>
<TextView android:id="@+id/txtOsd" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top" android:layout_marginTop="62dp"
    android:background="@drawable/vlc_osd_background" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="#FFFFFF" android:textSize="13sp"
    android:visibility="gone" />
<LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="bottom" android:background="@drawable/vlc_hud_bottom" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/txtTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="00:00" android:textColor="#FFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/txtRemaining" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end" android:text="-00:00"
            android:textColor="#CCFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <com.mpcmovil.VlcAccessibleSeekBar android:id="@+id/seekBar"
        android:layout_width="match_parent" android:layout_height="24dp"
        android:max="1000" android:minHeight="4dp" android:maxHeight="4dp"
        android:paddingStart="0dp" android:paddingEnd="0dp"
        android:progressDrawable="@drawable/vlc_seekbar_track" android:thumb="@drawable/vlc_seekbar_thumb"
        android:thumbOffset="9dp" android:splitTrack="false" android:contentDescription="Barra de progreso del video" />
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/playerControlsRow"
        android:layout_width="match_parent" android:layout_height="46dp">
        <LinearLayout android:id="@+id/playerControlsLeft" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical|start" android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageButton android:id="@+id/btnAudioTrack" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="42dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vlc_ic_audiotrack" android:scaleType="fitCenter" android:padding="9dp"
                android:contentDescription="Pistas de audio" />
            <ImageButton android:id="@+id/btnSubtitleTrack" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="42dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vlc_ic_subtitle" android:scaleType="fitCenter" android:padding="9dp"
                android:contentDescription="Subtítulos" />
        </LinearLayout>
        <LinearLayout android:id="@+id/playerControlsCenter" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <Button android:id="@+id/btnBack" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="44dp" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="0dp"
                android:text="↶" android:textAllCaps="false" android:textColor="#F2FFFFFF" android:textSize="22sp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Retroceder" />
            <ImageButton android:id="@+id/btnPlay" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="46dp" android:layout_height="46dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/vlc_ic_pause_player"
                android:scaleType="fitCenter" android:padding="8dp" android:contentDescription="Pausar" />
            <Button android:id="@+id/btnForward" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="44dp" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="0dp"
                android:text="↷" android:textAllCaps="false" android:textColor="#F2FFFFFF" android:textSize="22sp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Avanzar" />
        </LinearLayout>
        <LinearLayout android:id="@+id/playerControlsRight" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical|end" android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageButton android:id="@+id/btnRotateBottom" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="40dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vlc_ic_rotate" android:scaleType="fitCenter" android:padding="9dp" android:contentDescription="Rotación" />
            <ImageButton android:id="@+id/btnCastBottom" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="40dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vlc_ic_cast" android:scaleType="fitCenter" android:padding="9dp" android:contentDescription="Emitir" />
            <Button android:id="@+id/btnSpeed" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="48dp" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:text="1.0x"
                android:textAllCaps="false" android:textColor="#F2FFFFFF" android:textSize="12sp" />
            <Button android:id="@+id/btnMainMenu" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="40dp" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:text="⋮"
                android:textColor="#FFFFFFFF" android:textSize="23sp" android:contentDescription="Más opciones" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button android:id="@+id/btnHwSw" style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:minWidth="0dp"
        android:minHeight="0dp" android:text="HW" />
    <Button android:id="@+id/btnPause" style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:minWidth="0dp" android:minHeight="0dp" />
    <Button android:id="@+id/btnStop" style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:minWidth="0dp" android:minHeight="0dp" />
    <TextView android:id="@+id/txtDecoderInfo" android:layout_width="wrap_content" android:layout_height="1dp"
        android:visibility="gone" android:text="[HW]" android:textColor="#78D6A1" android:textSize="1sp" />
</LinearLayout>
<Button android:id="@+id/btnScreenshotFloat" style="@style/Widget.AppCompat.Button.Borderless"
    android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center_vertical|end"
    android:layout_marginEnd="14dp" android:backgroundTint="#CC202020" android:visibility="gone"
    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="▣"
    android:textColor="#FFFFFF" android:textSize="21sp" />
</FrameLayout>
