<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/background_default" />
            <stroke android:width="1dp" android:color="?attr/player_icon_color" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/background_default" />
            <stroke android:width="1dp" android:color="?attr/player_icon_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/background_default_darker" />
            <stroke android:width="1dp" android:color="?attr/background_default" />
        </shape>
    </item>
</selector>
